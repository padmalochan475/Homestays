# Server Port
PORT=4000

# Client URLs allowed by CORS (comma-separated for multiple origins, e.g. local and live Render domains)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# MongoDB Connection String (MongoDB Atlas cluster URI recommended for college projects and live deployment)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/homestays?retryWrites=true&w=majority
DB_URL=

# JWT Secret for session authentication (auto-generated by setup.ps1 if left blank)
JWT_SECRET=

# Optional: Email OTP Settings (Gmail OAuth2)
# If left blank, the application automatically runs in DEMO OTP mode (code displayed on screen)
MAIL_USERNAME=
OAUTH_CLIENTID=
OAUTH_CLIENT_SECRET=
OAUTH_REFRESH_TOKEN=

# Optional: AWS S3 Settings for Image Uploads
# If left blank, photos are automatically stored locally in api/uploads and served seamlessly
AWS_REGION=eu-north-1
BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
