# ==============================================================================
# HomeStays - Environment Configuration Template
# All settings below can be customized by students/administrators.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Network Configuration
# ------------------------------------------------------------------------------
PORT=4000
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database Connection (MongoDB Atlas URI)
# ------------------------------------------------------------------------------
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/homestays?retryWrites=true&w=majority
DB_URL=

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# 64-character cryptographic token secret (auto-generated if left blank)
JWT_SECRET=

# ------------------------------------------------------------------------------
# 4. Administrator & Host Credentials (Editable by Students)
# Change these values anytime to customize the default admin and host accounts!
# ------------------------------------------------------------------------------
# Dedicated Platform Administrator Account (Access to /admin portal)
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@homestays.com
ADMIN_PASSWORD=Admin@123

# Default Demo Property Host Account (Access to /account/places)
HOST_NAME=Demo Host
HOST_EMAIL=demo@homestays.com
HOST_PASSWORD=Demo@123

# ------------------------------------------------------------------------------
# 5. Optional: Email OTP Settings (Google Cloud OAuth2)
# If left blank, the application automatically runs in DEMO OTP mode (code shown on screen)
# ------------------------------------------------------------------------------
MAIL_USERNAME=
OAUTH_CLIENTID=
OAUTH_CLIENT_SECRET=
OAUTH_REFRESH_TOKEN=

# ------------------------------------------------------------------------------
# 6. Optional: AWS S3 Cloud Storage Settings
# If left blank, photos are automatically saved to api/uploads on local disk
# ------------------------------------------------------------------------------
AWS_REGION=eu-north-1
BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
