{
  "name": "homestays",
  "version": "1.0.0",
  "private": true,
  "description": "HomeStays - Fullstack Vacation Rental Booking Application",
  "scripts": {
    "student": "node scripts/student-wizard.js",
    "render": "node scripts/render-assistant.js",
