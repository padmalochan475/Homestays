{
  "name": "homestays",
  "version": "1.0.0",
  "private": true,
  "description": "HomeStays - Fullstack Vacation Rental Booking Application",
  "scripts": {
    "start": "node scripts/orchestrator.js",
    "doctor": "node scripts/orchestrator.js --doctor",
    "warmup": "node scripts/orchestrator.js --warmup",
    "reset": "node scripts/orchestrator.js --reset",
    "seed": "node scripts/seed.js",
    "start:api": "npm start --prefix api",
    "start:client": "npm run dev --prefix client",
    "build:client": "npm run build --prefix client",
    "configure:render": "powershell -ExecutionPolicy Bypass -File ./scripts/configure-render.ps1"
  }
}
